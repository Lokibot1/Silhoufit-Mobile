# Same Supabase project and API as the web app (SilhouFit). Only EXPO_PUBLIC_ vars reach the app bundle.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# In development the app takes the PC's address from the Expo dev server, so a local/LAN value here (or none) is replaced automatically and only its port matters (default 3000). A real hostname (https://api...) and production builds use this value as written.
EXPO_PUBLIC_API_URL=
# Deployed web app; the Terms of Service and Privacy Policy links open its pages. Defaults to https://silhoufit-frontend.vercel.app when empty.
EXPO_PUBLIC_SITE_URL=
